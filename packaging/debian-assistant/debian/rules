#!/usr/bin/make -f
# lingos-assistant 打包：源码直拷到 /usr/share/lingos/python，
# 由 postinst 在 /usr/lib/lingos/venv 内安装（保证入口脚本与依赖可用，PRD 5.7）。

%:
	dh $@

override_dh_auto_build:
	# 无需编译（纯 Python，postinst 阶段在 venv 内安装）

override_dh_auto_install:
	# 由 dh_install 完成

override_dh_install:
	dh_install
	# systemd user unit
	install -Dm0644 ../systemd/lingos-assistantd.service \
		debian/lingos-assistant/usr/lib/systemd/user/lingos-assistantd.service
	# Python 源（daemon + ui），postinst 在 venv 内 pip install 此目录
	mkdir -p debian/lingos-assistant/usr/share/lingos/python
	cp -r ../../daemon/lingos_assistantd \
		debian/lingos-assistant/usr/share/lingos/python/
	cp -r ../../ui/lingos_assistant_ui \
		debian/lingos-assistant/usr/share/lingos/python/
	cp ../../daemon/pyproject.toml \
		debian/lingos-assistant/usr/share/lingos/python/
	# 桌面入口 + 图标 + gschema + 样式
	install -Dm0644 ../../ui/lingos_assistant_ui/data/com.lingos.assistant.desktop.in \
		debian/lingos-assistant/usr/share/applications/com.lingos.assistant.desktop
	install -Dm0644 ../../ui/lingos_assistant_ui/data/icons/com.lingos.assistant.svg \
		debian/lingos-assistant/usr/share/icons/hicolor/scalable/apps/com.lingos.assistant.svg
	install -Dm0644 ../../ui/lingos_assistant_ui/data/com.lingos.assistant.gschema.xml \
		debian/lingos-assistant/usr/share/glib-2.0/schemas/com.lingos.assistant.gschema.xml
	install -Dm0644 ../../ui/lingos_assistant_ui/data/style.css \
		debian/lingos-assistant/usr/share/lingos/style.css
	# UI 启动器（供扩展/应用网格调用）
	install -Dm0755 debian/lingos-assistant-ui.wrapper \
		debian/lingos-assistant/usr/bin/lingos-assistant-ui

override_dh_installsystemduser:
	dh_installsystemduser --no-enable --no-start
